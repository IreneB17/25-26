int t1 = millis() / 1000;
int r = 0;
int g = 0;
int b = 0;

void main() {
  animate(temp);
}

void temp() {
  int t2 = millis() / 1000;

  background(r, g, b);
  fill(255);

  text("t1: " + t1, 20, 20);
  text("t2: " + t2, 20, 40);

  
  if (t2 - t1 > 5) {
    t1 = t2;
    r = random(0, 255);
    g = random(0, 255);
    b = random(0, 255);
    println("Cambio de color");
  }
}
