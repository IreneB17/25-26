 text-align: center;

}

 .portada h1{
  font-size: 50px;

}

 .portada p {
  font-size: 20px;
  width: 60%

}

/* INDICE*/
.indice{
 background: #001f3f;
 color: white;
 padding: 20px;
}

.indice a{
 color: #00d4ff;
 text-decoration: none;
 display: block;
 margin: 5px;

}

/*SECCIONES*/
.seccion{
 padding: 50px;
 text-align: center;

}

.seccion:nth-child(even){
 background: #f0f8ff;
}

.seccion img{
 width: 300px;
 cursor: pointer;
 transition: transform 0.3s;
 }

.seccion img:hover{
 transform: scale(1.1);
}

/*INFO OCULTA*/
.info{
 display: none;
 margin-top: 20px ;
 background: #002f5b;
 color: white;
 padding: 15px;
 border-radius: 10px;
}

</style> 

<script>
function mostrarInfo(id){
 var elemento = document.getElementById(id)

 if (elemento.style.display == "block") {
  elemento.style.display= "none";
 }else{
  elemento.style.display= "block";
}
}
</script>

</head>

